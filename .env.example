DB_HOST=127.0.0.1
DB_NAME=maison_aurelle
DB_USER=root
DB_PASS=

# AI concierge (optional). Leave LLM_API_KEY empty and it answers from the built-in FAQ, at no cost.
# Uses the Claude Messages API format. Never commit a real key: .env is ignored by git.
LLM_API_URL="https://api.anthropic.com/v1/messages"
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# Email (optional). "file" saves messages to storage/mail, so you can read them without a mail server.
# To really send them, set MAIL_TRANSPORT=smtp and fill in your provider's details.
MAIL_TRANSPORT=file
MAIL_FROM="concierge@maison-aurelle.example"
FRONT_DESK_EMAIL="concierge@maison-aurelle.example"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# starttls, ssl or none
SMTP_SECURE=starttls
# The site's address, used for links inside emails.
SITE_URL="http://localhost:8000"

# Staff sign-in at login.php. Leave this empty and nobody can sign in.
# Set the password with: C:\xampp\php\php.exe tools\set-admin-password.php
ADMIN_PASSWORD_HASH=''
# ADMIN_USERNAME=admin
# The Database tab's phpMyAdmin button. It only shows on the computer running the site.
# PHPMYADMIN_URL=http://localhost/phpmyadmin/index.php
